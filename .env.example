# Text to speech. Any OpenAI-compatible /audio/speech endpoint.
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=sk-your-key
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Speech to text, used ONLY to check the finished file against the script.
# Any OpenAI-compatible /audio/transcriptions endpoint. Groq is fast and cheap here.
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=gsk-your-key
STT_MODEL=whisper-large-v3-turbo
